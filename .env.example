# Every value here is optional. The app runs with none of them set.

# Turns on the copy layer: a written verdict plus three rewrites per slot.
# Without it the deterministic rulebook still produces the full audit.
ANTHROPIC_API_KEY=

# Model and reasoning depth for the copy layer.
# CL_MODEL=claude-opus-5
# CL_EFFORT=medium

# Set this and storage moves from memory to Postgres. Run `npm run db:push`
# first. If the connection fails the app falls back to memory rather than
# failing to boot.
# DATABASE_URL=

# Replit maps 5000 to external port 80 on publish.
# PORT=5000
