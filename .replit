modules = ["nodejs-20", "web"]
run = "npm run dev"
entrypoint = "server/index.ts"
hidden = [".config", "dist", "node_modules", ".git"]

[nix]
channel = "stable-24_11"

[env]
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
# Deployment environments prune devDependencies, and the build tools (vite,
# esbuild, tailwind) live there. Install them explicitly or the build dies
# with "vite: not found".
build = ["bash", "-c", "npm ci --include=dev && npm run build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80
